rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Global Helpers ───
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWebmaster() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/webmaster/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'webmaster'
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidIndexId(id) {
      return id is string && id.size() > 0 && id.size() <= 160;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getSiteSettings() {
      return get(/databases/$(database)/documents/settings/site).data;
    }

    function submissionsGloballyEnabled() {
      return exists(/databases/$(database)/documents/settings/site) &&
        getSiteSettings().groupSubmissionEnabled == true;
    }

    function guestSubmissionsAllowed() {
      return submissionsGloballyEnabled() &&
        getSiteSettings().allowPublicSubmissions == true;
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && (
        existing().get('submittedBy', '') == request.auth.uid ||
        existing().get('submitterUid', '') == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/groupOwnership/$(groupId)) &&
          get(/databases/$(database)/documents/groupOwnership/$(groupId)).data.submittedBy == request.auth.uid
        )
      );
    }

    function isValidGroupStrings() {
      return incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 100
        && incoming().platform is string && incoming().platform.size() > 0 && incoming().platform.size() <= 60
        && incoming().joinUrl is string && incoming().joinUrl.size() > 0 && incoming().joinUrl.size() <= 500
        && incoming().description is string && incoming().description.size() >= 10 && incoming().description.size() <= 600
        && (!('categoryId' in incoming()) || (incoming().categoryId is string && incoming().categoryId.size() <= 128))
        && (!('categoryName' in incoming()) || (incoming().categoryName is string && incoming().categoryName.size() <= 100))
        && (!('contentType' in incoming()) || (incoming().contentType is string && incoming().contentType.size() <= 100))
        && (!('language' in incoming()) || (incoming().language is string && incoming().language.size() <= 80))
        && (!('minimumAge' in incoming()) || (incoming().minimumAge is string && incoming().minimumAge.size() <= 40))
        && (!('state' in incoming()) || (incoming().state is string && incoming().state.size() <= 100))
        && (!('district' in incoming()) || (incoming().district is string && incoming().district.size() <= 100))
        && (!('city' in incoming()) || (incoming().city is string && incoming().city.size() <= 100))
        && (!('rules' in incoming()) || (incoming().rules is string && incoming().rules.size() <= 1000))
        && (!('logoUrl' in incoming()) || (incoming().logoUrl is string && incoming().logoUrl.size() <= 1000))
        && (!('tags' in incoming()) || (incoming().tags is list && incoming().tags.size() <= 20));
    }

    // ─── Default Deny Catch-All ───
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Webmaster Collection ───
    // Client write is strictly DENIED. Webmaster records can only be provisioned server-side.
    match /webmaster/{webmasterId} {
      allow read: if isWebmaster();
      allow write: if false;
    }

    // ─── Counters Collection ───
    // Sequential counter for user provisioning. Client write is strictly DENIED.
    match /counters/{counterId} {
      allow read: if isWebmaster();
      allow write: if false;
    }

    // ─── Legacy Identity Map ───
    // Mapping legacy Firebase Auth UIDs to canonical LinkCloud UIDs. Server managed.
    match /legacyIdentityMap/{legacyUid} {
      allow read: if isSignedIn() && (request.auth.uid == legacyUid || isWebmaster());
      allow write: if false;
    }

    // ─── Users Collection ───
    match /users/{userId} {
      allow get: if isUser(userId) || isWebmaster();
      allow list: if isWebmaster();
      allow create: if isValidId(userId) && (
        isWebmaster() || (
          isUser(userId) &&
          (!('role' in incoming()) || incoming().role == 'user') &&
          (!('status' in incoming()) || incoming().status == 'pending_verification' || incoming().status == 'active') &&
          (!('emailVerified' in incoming()) || incoming().emailVerified == false || (
            request.auth.token.email_verified == true &&
            (!('email' in incoming()) || incoming().email == request.auth.token.email)
          )) &&
          (!('phoneVerified' in incoming()) || incoming().phoneVerified == false || request.auth.token.phone_number != null)
        )
      );
      allow update: if isValidId(userId) && (
        (
          isWebmaster() && (
            request.auth.uid != userId ||
            (!('role' in incoming()) || incoming().role == 'webmaster')
          )
        ) || (
          isUser(userId) &&
          (!('uid' in incoming()) || incoming().uid == existing().uid) &&
          (!('accountUid' in incoming()) || !('accountUid' in existing()) || incoming().accountUid == existing().accountUid) &&
          (!('role' in incoming()) || incoming().role == existing().role) &&
          (
            !('status' in incoming()) ||
            incoming().status == existing().status ||
            (
              existing().get('status', '') == 'pending_verification' &&
              incoming().status == 'active' &&
              (request.auth.token.email_verified == true || request.auth.token.phone_number != null)
            )
          ) &&
          (!('email' in incoming()) || incoming().email == existing().email || (
            request.auth.token.email_verified == true &&
            incoming().email == request.auth.token.email
          )) &&
          (!('emailVerified' in incoming()) || incoming().emailVerified == existing().get('emailVerified', false) || (
            request.auth.token.email_verified == true &&
            incoming().emailVerified == true
          )) &&
          (!('phoneVerified' in incoming()) || incoming().phoneVerified == existing().get('phoneVerified', false) || (
            request.auth.token.phone_number != null &&
            incoming().phoneVerified == true
          ))
        )
      );
      allow delete: if isWebmaster() && request.auth.uid != userId;

      // Subcollection: Email Change History
      match /email_history/{historyId} {
        allow read: if isUser(userId) || isWebmaster();
        allow create, update: if isValidId(historyId) && (isUser(userId) || isWebmaster());
        allow delete: if isWebmaster();
      }

      // Subcollection: Active Email Change Projection
      match /emailChanges/{changeId} {
        allow read: if isUser(userId) || isWebmaster();
        allow create, update: if isValidId(changeId) && (isUser(userId) || isWebmaster());
        allow delete: if isWebmaster();
      }
    }

    // ─── Groups Collection (Public Safe Projection) ───
    match /groups/{groupId} {
      allow get: if isValidId(groupId) && (
        (existing().status == 'approved' && existing().get('hidden', false) != true)
        || isWebmaster()
        || isGroupOwner(groupId)
      );

      allow list: if resource.data.status == 'approved'
        || isWebmaster()
        || (isSignedIn() && (
          resource.data.submittedBy == request.auth.uid ||
          resource.data.submitterUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ));

      allow create: if isValidId(groupId) && isValidGroupStrings() && (
        isWebmaster() || (
          submissionsGloballyEnabled() &&
          incoming().submittedBy is string && incoming().submittedBy.size() <= 128 &&
          incoming().status == 'pending' &&
          incoming().get('featured', false) == false &&
          incoming().get('pinned', false) == false &&
          incoming().get('hidden', false) == false &&
          incoming().get('viewsCount', 0) == 0 &&
          incoming().get('joinCount', 0) == 0 &&
          incoming().get('reportCount', 0) == 0 &&
          (
            (isSignedIn() && incoming().submittedBy == request.auth.uid) ||
            (!isSignedIn() && guestSubmissionsAllowed() && incoming().submittedBy == '')
          )
        )
      );

      allow update: if isValidId(groupId) && (
        isWebmaster() ||
        (
          isGroupOwner(groupId) &&
          isValidGroupStrings() &&
          (existing().status == 'pending' || existing().get('allowResubmit', false) == true) &&
          incoming().status == 'pending' &&
          incoming().get('submittedBy', '') == existing().get('submittedBy', '') &&
          incoming().get('featured', false) == existing().get('featured', false) &&
          incoming().get('pinned', false) == existing().get('pinned', false) &&
          incoming().get('hidden', false) == existing().get('hidden', false) &&
          incoming().get('viewsCount', 0) == existing().get('viewsCount', 0) &&
          incoming().get('joinCount', 0) == existing().get('joinCount', 0) &&
          incoming().get('reportCount', 0) == existing().get('reportCount', 0)
        ) ||
        (
          existing().status == 'approved' &&
          existing().get('hidden', false) != true &&
          (
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount']) &&
              incoming().viewsCount is int &&
              incoming().viewsCount == existing().get('viewsCount', 0) + 1
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['joinCount']) &&
              incoming().joinCount is int &&
              incoming().joinCount == existing().get('joinCount', 0) + 1
            ) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['reportCount']) &&
              incoming().reportCount is int &&
              incoming().reportCount == existing().get('reportCount', 0) + 1
            )
          )
        )
      );

      allow delete: if isValidId(groupId) && (
        isWebmaster() ||
        (isGroupOwner(groupId) && existing().status == 'pending')
      );
    }

    // ─── Private Group Ownership Metadata ───
    // Protects submitter PII from public extraction
    match /groupOwnership/{groupId} {
      allow read: if isWebmaster() || (isSignedIn() && resource.data.submittedBy == request.auth.uid);
      allow create: if isValidId(groupId) && (
        isWebmaster() ||
        (submissionsGloballyEnabled() && isSignedIn() && incoming().submittedBy == request.auth.uid) ||
        (guestSubmissionsAllowed() && !isSignedIn() && incoming().submittedBy == '')
      );
      allow update, delete: if isValidId(groupId) && (
        isWebmaster() ||
        (isSignedIn() && resource.data.submittedBy == request.auth.uid)
      );
    }

    // ─── Favorites Collection ───
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isWebmaster());
      allow create: if isValidId(favoriteId) && isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isValidId(favoriteId) && isSignedIn() && (existing().userId == request.auth.uid || isWebmaster());
    }

    // ─── Notifications Collection ───
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isWebmaster());
      allow update, delete: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isWebmaster());
      allow create: if isValidId(notificationId) && (isWebmaster() || (isSignedIn() && incoming().userId == request.auth.uid));
    }

    // ─── Reports Collection ───
    match /reports/{reportId} {
      allow read: if isWebmaster();
      allow create: if isValidId(reportId) &&
        incoming().keys().hasAll(['groupId', 'reportedBy', 'reason', 'details', 'status']) &&
        incoming().groupId is string && incoming().groupId.size() > 0 && incoming().groupId.size() <= 128 &&
        incoming().reportedBy is string && incoming().reportedBy.size() <= 128 &&
        (!('reportedByName' in incoming()) || (incoming().reportedByName is string && incoming().reportedByName.size() <= 100)) &&
        (!('groupName' in incoming()) || (incoming().groupName is string && incoming().groupName.size() <= 150)) &&
        incoming().reason is string && incoming().reason.size() > 0 && incoming().reason.size() <= 150 &&
        incoming().details is string && incoming().details.size() <= 500 &&
        incoming().status == 'pending' &&
        (
          (!isSignedIn() && incoming().reportedBy == '') ||
          (isSignedIn() && (incoming().reportedBy == '' || incoming().reportedBy == request.auth.uid))
        );
      allow update, delete: if isValidId(reportId) && isWebmaster();
    }

    // ─── Complaints Collection ───
    match /complaints/{complaintId} {
      allow read: if isWebmaster() || (isSignedIn() && existing().email == request.auth.token.email);
      allow create: if isValidId(complaintId) &&
        incoming().keys().hasAll(['name', 'email', 'subject', 'message', 'status']) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
        incoming().email is string && incoming().email.size() > 2 && incoming().email.size() <= 150 &&
        (!('phone' in incoming()) || (incoming().phone is string && incoming().phone.size() <= 20)) &&
        incoming().subject is string && incoming().subject.size() > 0 && incoming().subject.size() <= 150 &&
        incoming().message is string && incoming().message.size() >= 20 && incoming().message.size() <= 1500 &&
        incoming().status == 'pending';
      allow update, delete: if isValidId(complaintId) && isWebmaster();
    }

    // ─── Contact Messages Collection ───
    match /contacts/{contactId} {
      allow read: if isWebmaster() || (isSignedIn() && existing().email == request.auth.token.email);
      allow create: if isValidId(contactId) &&
        incoming().keys().hasAll(['name', 'email', 'subject', 'message', 'status']) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
        incoming().email is string && incoming().email.size() > 2 && incoming().email.size() <= 150 &&
        (!('phone' in incoming()) || (incoming().phone is string && incoming().phone.size() <= 20)) &&
        incoming().subject is string && incoming().subject.size() > 0 && incoming().subject.size() <= 150 &&
        incoming().message is string && incoming().message.size() >= 20 && incoming().message.size() <= 1000 &&
        incoming().status == 'unread';
      allow update, delete: if isValidId(contactId) && isWebmaster();
    }

    // ─── Categories Collection ───
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    // ─── Account Deletion Requests ───
    match /deletionRequests/{requestId} {
      allow read: if isWebmaster() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isValidId(requestId) && isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if isValidId(requestId) && (
        isWebmaster() ||
        (isSignedIn() && existing().uid == request.auth.uid && incoming().status == 'cancelled')
      );
      allow delete: if isValidId(requestId) && isWebmaster();
    }

    // ─── Email Change Requests ───
    match /emailChangeRequests/{requestId} {
      // Allow get by document ID for verification link processing & terminal validation
      allow get: if isValidId(requestId);
      // Restrict collection listing to Webmaster or owner querying their own requests
      allow list: if isWebmaster() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Authenticated user creating their own request
      allow create: if isValidId(requestId) && (
        isWebmaster() || (
          isSignedIn() &&
          incoming().userId == request.auth.uid &&
          incoming().requestId == requestId &&
          incoming().status == 'pending'
        )
      );

      // Update: Webmaster full access OR owner managing own request OR terminal verification status transition
      allow update: if isValidId(requestId) && (
        isWebmaster() || (
          // Authenticated owner managing own request (cancelling/superseding) with sensitive fields preserved
          (
            isSignedIn() &&
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().requestId == existing().requestId &&
            incoming().oldEmail == existing().oldEmail &&
            incoming().newEmail == existing().newEmail &&
            incoming().createdAt == existing().createdAt &&
            incoming().expiresAt == existing().expiresAt
          ) ||
          // Terminal verification flow transitioning pending -> verified / expired while locking sensitive fields
          (
            existing().status == 'pending' &&
            (incoming().status == 'verified' || incoming().status == 'expired') &&
            incoming().userId == existing().userId &&
            incoming().requestId == existing().requestId &&
            incoming().oldEmail == existing().oldEmail &&
            incoming().newEmail == existing().newEmail &&
            incoming().createdAt == existing().createdAt &&
            incoming().expiresAt == existing().expiresAt
          )
        )
      );

      // Delete: only Webmaster or authenticated owner
      allow delete: if isValidId(requestId) && (isWebmaster() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // ─── Account UID Registry ───
    // Client write is strictly DENIED. Managed server-side only. Read restricted to Webmaster.
    match /accountUidRegistry/{accountUid} {
      allow read: if isWebmaster();
      allow write: if false;
    }

    // ─── Email Index ───
    match /emailIndex/{email} {
      allow get: if isValidIndexId(email);
      allow list: if isWebmaster();
      allow create: if isValidIndexId(email) && (
        isWebmaster() || (
          isSignedIn() &&
          incoming().uid == request.auth.uid &&
          !exists(/databases/$(database)/documents/emailIndex/$(email))
        )
      );
      allow update: if isWebmaster();
      allow delete: if isWebmaster() || (isSignedIn() && existing().uid == request.auth.uid);
    }

    // ─── Mobile Index ───
    match /mobileIndex/{phone} {
      allow get: if isValidIndexId(phone);
      allow list: if isWebmaster();
      allow create: if isValidIndexId(phone) && (
        isWebmaster() || (
          isSignedIn() &&
          incoming().uid == request.auth.uid &&
          !exists(/databases/$(database)/documents/mobileIndex/$(phone))
        )
      );
      allow update: if isWebmaster();
      allow delete: if isWebmaster() || (isSignedIn() && existing().uid == request.auth.uid);
    }

    // ─── Deleted Accounts Tombstone ───
    match /deletedAccounts/{docId} {
      allow read: if isWebmaster();
      allow write: if isWebmaster();
    }

    // ─── Pending Registrations ───
    // Ephemeral staging records for 4-hour cleanup tracking. Server-managed, read restricted to Webmaster.
    match /pendingRegistrations/{uid} {
      allow read: if isWebmaster() || isUser(uid);
      allow write: if false;
    }

    // ─── Audit Logs ───
    // Tamper-proof security audit log: Append-only by Webmaster or authenticated actors; update and delete are strictly forbidden.
    match /audit_logs/{logId} {
      allow read: if isWebmaster();
      allow create: if isValidId(logId) && (
        isWebmaster() ||
        (isSignedIn() && (incoming().get('actorUid', '') == request.auth.uid || incoming().get('adminUid', '') == request.auth.uid))
      );
      allow update, delete: if false;
    }
    match /auditLogs/{logId} {
      allow read: if isWebmaster();
      allow create: if isValidId(logId) && (
        isWebmaster() ||
        (isSignedIn() && (incoming().get('actorUid', '') == request.auth.uid || incoming().get('adminUid', '') == request.auth.uid))
      );
      allow update, delete: if false;
    }

    // ─── Authentication Forensic Event Logs ───
    // Append-only telemetry for authentication events (login, OTP, Google, reset, verification).
    // Strictly forbids storing sensitive credential fields; read restricted to Webmaster; immutable.
    match /auth_logs/{logId} {
      allow read: if isWebmaster();
      allow create: if isValidId(logId) &&
        incoming().keys().hasAll(['event', 'method', 'outcome', 'failureType', 'portal', 'timestampIso']) &&
        incoming().event is string && incoming().event.size() <= 100 &&
        incoming().method is string && incoming().method.size() <= 40 &&
        (incoming().outcome == 'success' || incoming().outcome == 'failure') &&
        incoming().failureType is string && incoming().failureType.size() <= 60 &&
        !('password' in incoming()) &&
        !('pass' in incoming()) &&
        !('otp' in incoming()) &&
        !('otpCode' in incoming()) &&
        !('token' in incoming()) &&
        !('idToken' in incoming()) &&
        !('refreshToken' in incoming()) &&
        !('customToken' in incoming()) &&
        !('oobCode' in incoming());
      allow update, delete: if false;
    }

    match /auth_event_logs/{logId} {
      allow read: if isWebmaster();
      allow create: if isValidId(logId) &&
        incoming().keys().hasAll(['event', 'method', 'outcome', 'failureType', 'portal', 'timestampIso']) &&
        incoming().event is string && incoming().event.size() <= 100 &&
        incoming().method is string && incoming().method.size() <= 40 &&
        (incoming().outcome == 'success' || incoming().outcome == 'failure') &&
        incoming().failureType is string && incoming().failureType.size() <= 60 &&
        !('password' in incoming()) &&
        !('pass' in incoming()) &&
        !('otp' in incoming()) &&
        !('otpCode' in incoming()) &&
        !('token' in incoming()) &&
        !('idToken' in incoming()) &&
        !('refreshToken' in incoming()) &&
        !('customToken' in incoming()) &&
        !('oobCode' in incoming());
      allow update, delete: if false;
    }

    // ─── Site Settings ───
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    // ─── Website-Wide Announcements ───
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    // ─── FAQs ───
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    // ─── Help Articles ───
    match /help_articles/{articleId} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    // ─── Search Logs (Aggregated Telemetry) ───
    // Direct client write is strictly DENIED to prevent count manipulation, document spam, and abuse.
    // Ingestion occurs exclusively via the server-side telemetry endpoint (/api/telemetry/search-query).
    // Read is restricted exclusively to authorized Webmaster accounts.
    match /search_logs/{searchId} {
      allow read, write: if isWebmaster();
    }

    // ─── Visitor Stats (Aggregated Telemetry) ───
    // Direct client write is strictly DENIED to prevent count manipulation, document spam, and abuse.
    // Ingestion occurs exclusively via the server-side telemetry endpoint (/api/telemetry/visitor-hit).
    // Read is restricted exclusively to authorized Webmaster accounts.
    match /visitor_stats/{dateId} {
      allow read, write: if isWebmaster();
    }

    // ─── Platforms, Content Types & Languages ───
    match /platforms/{id} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    match /contentTypes/{id} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    match /languages/{id} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    // ─── States, Districts & Cities Collections ───
    match /states/{id} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    match /districts/{id} {
      allow read: if true;
      allow write: if isWebmaster();
    }

    match /cities/{id} {
      allow read: if true;
      allow write: if isWebmaster();
    }
  }
}
