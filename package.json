{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/linkcloud",
    "sitemap": "node scripts/generate-sitemap.cjs",
    "build": "(npm run build --workspace=@workspace/linkcloud || npm --prefix artifacts/linkcloud run build) && rm -rf dist && mkdir -p dist && cp -r artifacts/linkcloud/dist/. dist/ && node scripts/generate-sitemap.cjs",
    "typecheck": "tsc --build",
    "lint": "tsc --build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
