{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/linkcloud",
    "build": "npm run build --workspace=@workspace/linkcloud && mkdir -p dist && cp -r artifacts/linkcloud/dist/* dist/",
    "typecheck": "tsc --build",
    "lint": "tsc --build"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
